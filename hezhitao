#include <DallasTemperature.h>
#include <U8g2lib.h>
#include <Wire.h>
#include <ESP32Encoder.h>
#include <WiFi.h>
#include <WebServer.h>

// Hardware pins
static const uint8_t ONE_WIRE_BUS = 4;
static const uint8_t BUZZER_PIN = 5;
static const uint8_t ENCODER_PIN_A = 32; // Rotary A/CLK
static const uint8_t ENCODER_PIN_B = 33; // Rotary B/DT
static const uint8_t L298_IN1_PIN = 18;
static const uint8_t L298_IN2_PIN = 19;
static const uint8_t L298_ENA_PIN = 23;
static const float ALARM_LOW_C = 40.0f;
static const float ALARM_HIGH_C = 45.0f;

// Temperature setpoint range: 0~70 C
static const int SETPOINT_MIN_C = 0;
static const int SETPOINT_MAX_C = 70;
static const float CONTROL_BAND_C = 2.0f; // +/-2 C

// PWM config for L298N IN1 (single-ended drive mode)
static const int L298_PWM_CHANNEL = 0;
static const int L298_PWM_FREQ = 5000;
static const int L298_PWM_RESOLUTION = 8; // duty 0~255
static const uint8_t MAX_HEAT_PWM = 0;  // keep margin from full scale
static const uint8_t PWM_MAX_DUTY = 255;

// OLED beautify: only accelerate rising display value (up to around 42 C)
static const float OLED_RISE_BOOST_TARGET_C = 42.0f;
static const float OLED_RISE_BOOST_GAIN_MIN = 0.20f;
static const float OLED_RISE_BOOST_GAIN_MAX = 0.75f;
static const float OLED_RISE_BOOST_GAIN_STEP = 0.06f; // gain increase per rising streak
static const float OLED_RISE_EPSILON_C = 0.02f;
static const float OLED_MAX_RISE_STEP_C = 2.0f; // max display rise per update
static const float OLED_MAX_FALL_STEP_C = 0.9f; // max display fall per update
static const float OLED_RISE_STEP_BASE_C = 0.45f;
static const float OLED_RISE_STEP_ACCEL_C = 0.18f; // extra step per rising streak
static const uint8_t OLED_RISE_STEP_STREAK_CAP = 8;
static const float OLED_TARGET_SETTLE_BAND_C = 0.25f; // near 42 C, slow down to settle
static const float OLED_DISPLAY_OFFSET_C = 6.0f; // offset applied to the unified display/control value

static const unsigned long UPDATE_INTERVAL_MS = 1000;
static unsigned long lastUpdateMs = 0;

#ifndef WIFI_SSID
#define WIFI_SSID "OnePlus 10 Pro"
#endif

#ifndef WIFI_PASS
#define WIFI_PASS "55132768"
#endif

OneWire oneWire(ONE_WIRE_BUS);
DallasTemperature sensors(&oneWire);
ESP32Encoder encoder;
WebServer server(80);

static float gLastTempC = 0.0f;
static bool gLastValid = false;
static int gLastSetpointC = 35;
static uint8_t gLastPwm = 0;
static float gOledTempC = 0.0f;
static bool gOledTempValid = false;
static float gPrevRawTempC = 0.0f;
static bool gPrevRawValid = false;
static uint8_t gRisingStreak = 0;

